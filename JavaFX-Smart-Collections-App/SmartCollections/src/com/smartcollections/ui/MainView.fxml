<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.media.MediaView?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="com.smartcollections.ui.MainController">
	<top>
		<ToolBar>
			<TextField fx:id="txtSearch" promptText="Search..."
				prefWidth="350" />
			<Button text="Import" fx:id="btnImport"
				onAction="#handleImportFolder" />
			<Button text="Undo" fx:id="btnUndo" onAction="#onUndoClicked" />
			<Region HBox.hgrow="ALWAYS" />
			<Label fx:id="lblStatus" text="Ready" />
		</ToolBar>
	</top>

	<center>
		<SplitPane dividerPositions="0.35">
			<!-- Left: item listing -->
			<AnchorPane>
				<ListView fx:id="listView" AnchorPane.topAnchor="4"
					AnchorPane.bottomAnchor="4" AnchorPane.leftAnchor="4"
					AnchorPane.rightAnchor="4" />
			</AnchorPane>

			<!-- Right: detail pane -->
			<VBox spacing="8" VBox.vgrow="ALWAYS">
				<padding>
					<Insets top="12" right="12" bottom="12" left="12" />
				</padding>

				<Label text="Item Details"
					style="-fx-font-size: 14px; -fx-font-weight: bold;" />
				<GridPane hgap="8" vgap="8">
					<columnConstraints>
						<ColumnConstraints percentWidth="25" />
						<ColumnConstraints percentWidth="75" />
					</columnConstraints>

					<Label text="Title:" GridPane.rowIndex="0"
						GridPane.columnIndex="0" />
					<TextField fx:id="txtTitle" GridPane.rowIndex="0"
						GridPane.columnIndex="1" />

					<Label text="Category:" GridPane.rowIndex="1"
						GridPane.columnIndex="0" />
					<ComboBox fx:id="comboCategory" GridPane.rowIndex="1"
						GridPane.columnIndex="1" />

					<Label text="Tags:" GridPane.rowIndex="2"
						GridPane.columnIndex="0" />
					<TextField fx:id="txtTags" GridPane.rowIndex="2"
						GridPane.columnIndex="1" />

					<Label text="Rating:" GridPane.rowIndex="3"
						GridPane.columnIndex="0" />
					<Slider fx:id="sliderRating" GridPane.rowIndex="3"
						GridPane.columnIndex="1" min="1" max="5" snapToTicks="true"
						showTickLabels="true" />

					<Label text="Path/URL:" GridPane.rowIndex="4"
						GridPane.columnIndex="0" />
					<TextField fx:id="txtPath" GridPane.rowIndex="4"
						GridPane.columnIndex="1" />
				</GridPane>

				<HBox spacing="8">
					<Button text="Save" fx:id="btnSave"
						onAction="#onSaveClicked" />
					<Button text="Delete" fx:id="btnDelete"
						onAction="#onDeleteClicked" />
				</HBox>


				<Label text="Preview" />
				<TextArea fx:id="txtPreview" VBox.vgrow="ALWAYS"
					prefHeight="200" wrapText="true" editable="false" />
					
				<MediaView fx:id="mediaView" fitWidth="400"
					fitHeight="300" />

				<HBox spacing="8">
					<Button text="Play" fx:id="btnPlay"
						onAction="#onPlayClicked" />
					<Button text="Pause" fx:id="btnPause"
						onAction="#onPauseClicked" />
				</HBox>
			</VBox>
		</SplitPane>
	</center>

	<padding>
		<Insets top="6" right="6" bottom="6" left="6" />
	</padding>
</BorderPane>
